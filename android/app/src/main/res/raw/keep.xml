<!--
    shrinkResources (R8 kaynak küçültme) release build'de AÇIK
    (bkz. android/app/build.gradle). Google Sign-In SDK ve Firebase,
    google-services.json'dan üretilen aşağıdaki string kaynaklarını
    KOD REFERANSI OLMADAN, runtime'da reflection ile okuyor.
    Bu yüzden R8 bunları "kullanılmıyor" sanıp APK'dan siliyor ve
    Google girişi release build'de "DEVELOPER_ERROR (10)" ile
    başarısız oluyor — bu dosya olmadan.

    BU DOSYAYI SİLMEYİN / KALDIRMAYIN.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id,@string/google_api_key,@string/google_app_id,@string/google_crash_reporting_api_key,@string/google_storage_bucket,@string/gcm_defaultSenderId,@string/project_id" />
