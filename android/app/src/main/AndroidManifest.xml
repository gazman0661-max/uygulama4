<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 29.08.2026 kaldırıldı — uygulama artık reklam kullanmıyor (bkz.
         Appodeal SDK'sının tamamen sökülmesi), bu yüzden Play Console'a
         "Reklam Kimliği kullanmıyorum" diye dürüstçe beyan edilebilmesi
         için bu izin AKTİF OLARAK reddediliyor. Sadece satırı silmek
         YETMEZ: firebase_analytics paketinin kendi AAR'ındaki manifest
         de AYNI izni istiyor ve Android'in manifest-merge sistemi build
         sırasında ikisini birleştirir — yani izin sessizce GERİ
         sızabilir. tools:node="remove" bunu kesin olarak engeller.
         Firebase Analytics'in temel işlevi (olay/event loglama, kullanıcı
         özellikleri) bundan ETKİLENMEZ — sadece reklam kimliğine (GAID)
         bağlı analiz özellikleri (zaten kullanmadığımız) devre dışı
         kalır. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Uygulama içi satın alma (bkz. lib/services/billing_service.dart).
         in_app_purchase_android paketi bunu kendi AndroidManifest.xml'i
         üzerinden manifest merge ile OTOMATİK eklemeli, ama Play Console'un
         "APK'nıza FATURALANDIRMA iznini eklemeniz gerekir" uyarısı vermesi
         üzerine (2026-08-20) burada AÇIKÇA da tanımlandı — bazı build
         senaryolarında (ör. henüz hiç billing içeren bir APK yüklenmemişse)
         Play Console taramasının bunu güvenilir şekilde görmesi için. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Android 11+ paket görünürlüğü kısıtlaması: "Puan Ver" butonunun
         market://details?id=... linkini Play Store UYGULAMASINDA açabilmesi
         (tarayıcıya düşmeden) için bu sorgu izinleri gerekli. Olmazsa
         url_launcher bazı cihazlarda sessizce web linkine (https) düşer —
         yine çalışır ama Play Store uygulamasını değil tarayıcıyı açar. -->
    <queries>
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>


    <!-- Yerel bildirimler için: kota/pasif kullanıcı/proje hatırlatmaları.
         Bilinçli olarak SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM İSTEMİYORUZ:
         bildirimlerin dakika hassasiyetinde gitmesi gerekmiyor, inexact
         yeterli ve Play Store'un exact alarm izinlerine getirdiği kısıtlama/
         review riskinden kaçınıyoruz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Sitora"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- 31.08.2026 eklendi — APP LINKS: Firebase Auth'un e-posta
                 doğrulama ve şifre sıfırlama linkleri her zaman
                 "https://sitora-a9e27.firebaseapp.com/__/auth/action?..."
                 biçimindedir (bkz. lib/services/auth_service.dart >
                 _authDomain). android:autoVerify="true" ile Android, bu
                 alan adının .well-known/assetlinks.json dosyasını (Firebase
                 Console > Project Settings'e eklenen SHA-256 parmak izi
                 sayesinde Firebase Hosting tarafından OTOMATİK sunulur)
                 kontrol eder; eşleşirse link TARAYICIYA hiç düşmeden
                 doğrudan bu uygulamaya (lib/services/auth_link_service.dart)
                 yönlendirilir.
                 ÖNEMLİ: SHA-256 parmak izi Firebase Console'da ilgili
                 Android app'in altına eklenmeden bu doğrulama BAŞARISIZ
                 olur ve link normal tarayıcı davranışına düşer — kod bunu
                 zaten tolere eder (bkz. auth_link_service.dart), ama App
                 Links'in çalışması için o adım (Play Console SHA-256 →
                 Firebase Console) şarttır. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="sitora-a9e27.firebaseapp.com"
                    android:pathPrefix="/__/auth/action"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- GERÇEK PUSH (FCM) — 03.09.2026 eklendi. Uygulama arka planda/
             kapalıyken gelen bir push'u Android OTOMATİK gösterir ama
             hangi kanalı kullanacağını bilmesi gerekir — burası
             NotificationService.dart'taki 'sitora_general' kanalıyla
             AYNI olmalı, yoksa push'lar varsayılan/isimsiz bir kanala
             düşer (kullanıcı bildirim ayarlarından kapatamaz/düzenleyemez). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sitora_general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- flutter_local_notifications: cihaz yeniden başladığında veya
             saat dilimi değiştiğinde planlanmış bildirimleri yeniden kurar. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
    </application>
</manifest>
